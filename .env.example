# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shreedash
DB_PASSWORD=change-me
DB_NAME=shreedash

# Admin login for /admin
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=

# Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to 1 when running behind a reverse proxy / load balancer that terminates HTTPS
TRUST_PROXY=0
