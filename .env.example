# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000
NODE_ENV=development

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shreedash
DB_PASSWORD=change-me
DB_NAME=shreedash

# Admin login for /admin (optional: leave ADMIN_PASSWORD_HASH empty to create the admin
# account once at /admin/setup with the code printed in the server log)
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=

# Optional: generated and stored in the database if empty. Long random string, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to 1 when running behind a reverse proxy / load balancer that terminates HTTPS
# (in production it is on by default; set 0 to turn it off)
TRUST_PROXY=

# ---------- AI voice agent ----------
# Public https address of this site (Exotel connects back to it for live call audio)
PUBLIC_BASE_URL=https://www.your-domain.com

# Sarvam AI (speech-to-text, voice and the agent's brain): https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Optional overrides
# SARVAM_CHAT_MODEL=sarvam-105b
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# Voice: defaults to priya (female) on bulbul:v3. Other female bulbul:v3 voices: ritu, neha, pooja, simran,
# kavya, ishita, shreya, roopa, tanya, shruti, suhani, kavitha, rupali. If you set VOICE_AGENT_NAME to a
# man's name, pick a male voice such as shubh, aditya, rahul or rohan.
SARVAM_TTS_SPEAKER=priya
# SARVAM_TTS_PACE=1.0

# Exotel (outbound calls from an Indian ExoPhone): Exotel dashboard > Settings > API
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Your ExoPhone number, the caller ID people see
EXOTEL_CALLER_ID=
# api.in.exotel.com for Indian (Mumbai) accounts, api.exotel.com for Singapore accounts
EXOTEL_API_HOST=api.in.exotel.com
# EXOTEL_RECORD=false

# Behaviour
VOICE_AGENT_NAME=Asha
COMPANY_EMAIL=hello@shreedash.example
# Wait this long after the enquiry before calling
VOICE_CALLBACK_DELAY_SECONDS=60
# Local hours when calls may go out (TRAI allows 9 am to 9 pm), and the time zone
VOICE_CALL_HOURS=9-20
VOICE_TIMEZONE=Asia/Kolkata
VOICE_MAX_ATTEMPTS=2
VOICE_RETRY_MINUTES=30
VOICE_MAX_CALL_SECONDS=600
# Set to off to switch a part off
VOICE_CALLBACKS=on
VOICE_WEB_ASSISTANT=on
